{
  "name": "@easecation/design",
  "version": "0.1.9",
  "description": "EaseCation 自研、可主题化、跨端友好的 React 设计系统与组件库",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./tokens": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./compat": {
      "types": "./dist/compat.d.ts",
      "import": "./dist/compat.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "TRADEMARKS.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "vite build",
    "build:storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "registry:check": "node scripts/validate-registry.mjs",
    "generate:component": "node scripts/generate-component.mjs",
    "ai:context": "node scripts/generate-ai-context.mjs",
    "ai:validate": "pnpm registry:check && pnpm typecheck && pnpm test",
    "pack:check": "node scripts/check-package.mjs",
    "check": "pnpm registry:check && pnpm visual:migration:check && pnpm check:open-source && pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm build:storybook && pnpm pack:check && pnpm build:example",
    "build:example": "pnpm --filter @easecation-design/example-generic-dashboard build",
    "check:open-source": "node scripts/check-open-source.mjs",
    "visual:migration:check": "node scripts/check-visual-migration.mjs",
    "visual:compare": "node scripts/visual/compare-console-neo.mjs",
    "visual:fixtures:install": "node scripts/visual/manage-console-fixtures.mjs install",
    "visual:fixtures:cleanup": "node scripts/visual/manage-console-fixtures.mjs cleanup"
  },
  "peerDependencies": {
    "react": ">=18.3.0 <20",
    "react-dom": ">=18.3.0 <20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@storybook/addon-a11y": "^9.1.10",
    "@storybook/addon-docs": "^9.1.10",
    "@storybook/react-vite": "^9.1.10",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "ajv": "^8.17.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "^9.1.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^7.2.2",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.8"
  },
  "keywords": [
    "react",
    "design-system",
    "ui",
    "components",
    "easecation",
    "webview"
  ],
  "license": "MIT",
  "packageManager": "pnpm@11.17.0",
  "dependencies": {
    "@fontsource-variable/geist": "5.2.8",
    "@fontsource-variable/outfit": "5.2.8",
    "@tanstack/react-table": "^8.21.3",
    "lucide-react": "^0.577.0",
    "radix-ui": "^1.6.7",
    "sonner": "^2.0.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0",
    "next-themes": "^0.4.6"
  }
}
