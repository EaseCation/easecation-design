{
  "name": "@easecation/design",
  "version": "0.19.0",
  "description": "EaseCation 自研、可主题化、跨端友好的 React 设计系统与组件库",
  "homepage": "https://github.com/EaseCation/easecation-design#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EaseCation/easecation-design.git"
  },
  "bugs": {
    "url": "https://github.com/EaseCation/easecation-design/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./eslint": {
      "types": "./eslint.d.ts",
      "import": "./eslint.js"
    },
    "./package.json": "./package.json",
    "./compat": {
      "types": "./dist/compat.d.ts",
      "import": "./dist/compat.js"
    },
    "./compat/antd": {
      "types": "./dist/antd-compat.d.ts",
      "import": "./dist/antd-compat.js"
    }
  },
  "files": [
    "dist",
    "eslint.js",
    "eslint.d.ts",
    "README.md",
    "LICENSE",
    "NOTICE",
    "TRADEMARKS.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "vite build",
    "build:storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm exec eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "test": "vitest run",
    "test:watch": "vitest",
    "registry:check": "node scripts/validate-registry.mjs",
    "tokens:generate": "node scripts/generate-tokens.mjs",
    "tokens:check": "node scripts/generate-tokens.mjs --check",
    "docs:generate": "pnpm build && node scripts/generate-api-docs.mjs",
    "docs:check": "node scripts/generate-api-docs.mjs --check",
    "test:browser": "node scripts/check-browser.mjs",
    "generate:component": "node scripts/generate-component.mjs",
    "ai:context": "node scripts/generate-ai-context.mjs",
    "ai:validate": "pnpm registry:check && pnpm typecheck && pnpm test",
    "pack:check": "node --test scripts/package-size.test.mjs && node scripts/check-package.mjs",
    "check": "pnpm check:deps-risk && pnpm format:check && pnpm tokens:check && pnpm registry:check && pnpm visual:migration:check && pnpm check:open-source && pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm test:browser && pnpm docs:check && pnpm build:storybook && pnpm pack:check && pnpm build:example && pnpm test:interactions && pnpm test:pagination && pnpm test:motion",
    "check:deps-risk": "pnpm audit --audit-level high",
    "build:example": "pnpm --filter @easecation-design/example-generic-dashboard build",
    "check:open-source": "node scripts/check-open-source.mjs",
    "visual:migration:check": "node scripts/check-visual-migration.mjs",
    "visual:compare": "node scripts/visual/compare-console-neo.mjs",
    "visual:fixtures:install": "node scripts/visual/manage-console-fixtures.mjs install",
    "visual:fixtures:cleanup": "node scripts/visual/manage-console-fixtures.mjs cleanup",
    "test:interactions": "node scripts/check-interactions.mjs",
    "test:pagination": "node scripts/check-pagination.mjs",
    "test:motion": "node scripts/check-motion.mjs"
  },
  "peerDependencies": {
    "react": ">=18.3.0 <20",
    "react-dom": ">=18.3.0 <20"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@microsoft/api-extractor": "7.59.2",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.17.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "^10.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.1"
  },
  "keywords": [
    "react",
    "design-system",
    "ui",
    "components",
    "easecation",
    "webview"
  ],
  "license": "MIT",
  "packageManager": "pnpm@11.17.0",
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "~1.47.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0"
  }
}
