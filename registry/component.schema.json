{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EaseCation Design component registry",
  "type": "object",
  "required": [
    "schemaVersion",
    "components"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "importPath",
          "category",
          "maturity",
          "platforms",
          "accessibility",
          "tokens",
          "stories",
          "deprecated"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]+$"
          },
          "importPath": {
            "type": "string",
            "pattern": "^@easecation/design"
          },
          "category": {
            "enum": [
              "foundation",
              "layout",
              "input",
              "navigation",
              "display",
              "feedback",
              "platform"
            ]
          },
          "maturity": {
            "enum": [
              "experimental",
              "beta",
              "stable"
            ]
          },
          "platforms": {
            "type": "array",
            "items": {
              "enum": [
                "web",
                "pwa",
                "android-webview",
                "ios-wkwebview",
                "windows-webview2",
                "ssr"
              ]
            },
            "minItems": 1
          },
          "accessibility": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tokens": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^--[a-z][a-z0-9-]*$"
            }
          },
          "stories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "deprecated": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
